[Unit]
Description=CodexaCoin staking pool watcher pass (one-shot, run by gateway-watcher.timer)
After=network.target codexacoind.service

[Service]
Type=oneshot
User=__USER__
Group=__GROUP__
EnvironmentFile=/etc/cac-gateway.conf
WorkingDirectory=__BUILD_DIR__
ExecStart=__BUILD_DIR__/venv/bin/python3 __BUILD_DIR__/watcher.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cac-gateway
